# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/servease_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRE=30d

# CORS Allowed Client URL (Frontend Vercel URL)
CLIENT_URL=https://your-servease-app.vercel.app

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Payment Gateway (Optional / Placeholder)
STRIPE_SECRET_KEY=sk_test_51Pxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
